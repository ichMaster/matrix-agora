# Кіра's own env file (v5.7) — copy to server/kira.env (gitignored); server/deploy.sh syncs it to the host 0600.
# Loaded ONLY by the `kira` service, beside the shared .env and voice.env. Every value leaves her environment at start.
# Her bot's token, from @BotFather (/newbot). Unset: Telegram off.
TELEGRAM_BOT_TOKEN=
# The owner's numeric Telegram id (e.g. from @userinfobot) — the only sender she answers there. Unset: Telegram off.
TELEGRAM_OWNER_ID=
# Deepgram's key, copied from server/hermes.env — she hears the owner's voice notes (nova-2, uk). Unset: hearing off.
DEEPGRAM_API_KEY=
