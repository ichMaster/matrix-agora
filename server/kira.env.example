# Кіра's own env file (v5.7) — copy to server/kira.env (gitignored); server/deploy.sh syncs it to the host 0600.
# Loaded ONLY by the `kira` service, beside the shared .env and voice.env. Every value leaves her environment at start.
# Her bot's token, from @BotFather (/newbot). Unset: Telegram off.
TELEGRAM_BOT_TOKEN=
# The owner's numeric Telegram id (e.g. from @userinfobot) — the only sender she answers there. Unset: Telegram off.
TELEGRAM_OWNER_ID=
# Deepgram's key, copied from server/hermes.env — she hears the owner's voice notes (nova-2, uk). Unset: hearing off.
DEEPGRAM_API_KEY=
# v5.8: her answers (in Agora, in the private chat, writing first) on Gemini 3.1 Pro with thinking; her background calls
# (summaries, memories, plans, the today block, the facts) stay on GEMINI_MODEL. Non-secret; the other agents never read
# this file. Empty: the same model as GEMINI_MODEL.
GEMINI_REPLY_MODEL=gemini-3.1-pro-preview
# v5.8.2 (the owner, 2026-10-25): where she writes first — last (the door he used last), telegram or matrix.
PRIVATE_FIRST_DOOR=telegram
