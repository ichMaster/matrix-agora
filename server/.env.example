# Generate with: openssl rand -hex 24  (lives only on the Ubuntu host, never in git)
REGISTRATION_TOKEN=

# --- the agents (v3.2): the same names as the repo's .env.example; production values live here ---
# HOMESERVER is overridden to http://homeserver:8008 inside compose
HOMESERVER=http://192.168.1.197:8008
# MSC-style opaque room id (Room settings → Advanced), no server suffix
ROOM_ID=
OWNER=@ich:agora.lan
ADA_PASSWORD=
BRUNO_PASSWORD=
# v4.2: the cat (the admin room creates his account; the password it prints goes here)
KIT_PASSWORD=
GEMINI_API_KEY=
HISTORY_N=40
# v4.1: the reply cap; a reply cut by it is trimmed to its last complete sentence
REPLY_MAX_TOKENS=200
# v4.1: agent messages per wave, counting the one being answered (v1.2's value + 1)
MAX_BOT_TURNS=3
# v4.1: how many agents answer an owner message that names no one
OWNER_REPLIERS=2
# v4.1: if nobody answered the owner after this many seconds, the best-ranked unchosen agent does
FALLBACK_S=30
# v4.2: the cat — how often he reacts unasked, how often a reaction is a purr (free), his word cap
CAT_REACT_P=0.3
CAT_PURR_P=0.8
CAT_MAX_WORDS=12
# v4.3: how often one of his spoken lines retells a past-life thesis
CAT_MEMORY_P=0.25
BOT_REPLY_P=0.5
REPLY_DELAY_S=4
BOT_WINDOW_S=600
SESSION_IDLE_S=900
SESSION_MAX_MESSAGES=200
SUMMARY_MAX_WORDS=200
LOCATION=Львів, Україна
TIMEZONE=Europe/Kyiv
PLAN_MAX_WORDS=120
PLAN_MUTATION_RATE=0.3
MEMORY_DAYS=7
MEMORY_WEEKS=4
MEMORY_MONTHS=6
DAY_MEMORY_MAX_WORDS=120
WEEK_MEMORY_MAX_WORDS=150
MONTH_MEMORY_MAX_WORDS=200
YEAR_MEMORY_MAX_WORDS=300
TODAY_MAX_WORDS=100
# v3.1 token report — USD per 1M tokens; leave empty for no cost column
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
# the agent image tag to run: latest (the newest release) or edge (main, before a release)
AGENT_IMAGE_TAG=latest

# --- the panel (v3.3) ---
# openssl rand -hex 32 — read it from this file to sign in; never printed or committed
PANEL_TOKEN=
PANEL_IMAGE_TAG=latest
# the host's LAN address the panel listens on — docker-published ports bypass ufw; unset = 127.0.0.1
PANEL_BIND=192.168.1.197
# where the stack lives on the host (the panel runs compose against $STACK_DIR/server for a start)
STACK_DIR=/home/ich/matrix-agora
# the host's docker group id (getent group docker)
DOCKER_GID=999
