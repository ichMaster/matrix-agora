# Устина's own env file (v6.2) — copy to server/ustyna.env (gitignored); server/deploy.sh syncs it to the host 0600.
# Loaded ONLY by the `ustyna` service (from v6.3), beside the shared .env and voice.env. Every value leaves her
# environment at start. The same keys as Кіра's server/kira.env — her own bot, the rest on the owner's word.
# Her bot's token, from @BotFather (/newbot) — a bot of her own, never Кіра's. Unset: Telegram off.
TELEGRAM_BOT_TOKEN=
# The owner's numeric Telegram id (the same as in kira.env) — the only sender she answers there. Unset: Telegram off.
TELEGRAM_OWNER_ID=
# Deepgram's key, copied from server/hermes.env — she hears the owner's voice notes. Unset: hearing off.
DEEPGRAM_API_KEY=
# Her answers' model (Agora, the private chat, writing first); her background calls stay on GEMINI_MODEL. Empty: the
# same model as GEMINI_MODEL.
GEMINI_REPLY_MODEL=
# Where she writes first — last (the door he used last), telegram or matrix.
PRIVATE_FIRST_DOOR=
# Her voice: the text-to-speech model that performs her audio tags, and its stability.
ELEVENLABS_MODEL=
VOICE_STABILITY=
# Her reading of The Guardian (the Open Platform key — the same as Кіра's, or one of her own). Unset: no Guardian.
GUARDIAN_API_KEY=
# The backup for her private chat when Gemini blocks or refuses (NovelAI's Persistent API Token, and the model).
# FALLBACK_MODEL empty: no backup.
NOVELAI_API_TOKEN=
FALLBACK_MODEL=
# Her кружечок on fal.ai (fal.ai/dashboard/keys, preset API; see docs/fal-ai.md). Unset: no кружечок.
FAL_KEY=
# v7.4: her answer models paid by the token (her panel switch ANSWER_MODEL): GPT-6.1 Sol on OpenAI's API and Sonnet
# on Anthropic's. They leave her environment at start. The Anthropic key is never named ANTHROPIC_*: a Claude client on
# the subscription refuses that name. Unset: that choice is off (silence, said in her log).
OPENAI_API_KEY=
SONNET_API_KEY=
