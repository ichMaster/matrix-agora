# Claude's own env file (v4.4) — copy to server/claude.env (gitignored); server/deploy.sh syncs it to the host.
# Loaded ONLY by the `claude` service, and holds only what is Claude's own: the room and the turn settings come from
# the shared server/.env through compose (review #5). Never put an ANTHROPIC_* or CLAUDE_CODE_USE_* variable here or
# anywhere: the agent refuses to start with one — it runs on the owner's Max subscription only.
CLAUDE_PASSWORD=
# `claude setup-token` on the Mac (the Max account) prints a one-year OAuth token
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=opus
# the output cap in tokens; 0 = none (the owner, 2026-10-11) — the brief keeps replies chat-sized
CLAUDE_CODE_MAX_OUTPUT_TOKENS=0
# a reply never waits longer than this for the SDK (seconds)
CLAUDE_TIMEOUT_S=90
