# Claude's own env file (v4.4) — copy to server/claude.env (gitignored); server/deploy.sh syncs it to the host.
# Loaded ONLY by the `claude` service. Never put an ANTHROPIC_* or CLAUDE_CODE_USE_* variable here or anywhere:
# the agent refuses to start with one — it runs on the owner's Max subscription only.
ROOM_ID=
OWNER=@ich:agora.lan
CLAUDE_PASSWORD=
# `claude setup-token` on the Mac (the Max account) prints a one-year OAuth token
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=opus
CLAUDE_CODE_MAX_OUTPUT_TOKENS=300
TIMEZONE=Europe/Kyiv
HISTORY_N=40
REPLY_MAX_TOKENS=200
MAX_BOT_TURNS=3
OWNER_REPLIERS=2
FALLBACK_S=30
BOT_REPLY_P=0.5
REPLY_DELAY_S=4
BOT_WINDOW_S=600
