# Лілі's own env file (v8.1) — copy to server/lili.env (gitignored); server/deploy.sh syncs it to the host 0600.
# Loaded ONLY by the `lili` service, beside the shared .env (the room, the owner, LILI_PASSWORD, the turn settings).
# Lumi's agora space: prod 8765 (the dev instance, 8766, is for the live test from the Mac: server/lili.dev.env)
LUMI_URL=http://192.168.1.197:8765
# The room's token — Lumi's `spaces.agora.token`, scoped to the agora channel and its routes. Never Lumi's owner token.
LUMI_ROOM_TOKEN=
