# Shared config for the agents (copy to .env; .env is gitignored).
HOMESERVER=http://192.168.1.197:8008
# MSC-style opaque room id (Room settings → Advanced), no server suffix
ROOM_ID=
OWNER=@ich:agora.lan
ADA_PASSWORD=
BRUNO_PASSWORD=
# v4.2: the cat (the admin room creates his account; the password it prints goes here)
KIT_PASSWORD=
# v5.5: the four newcomers (the owner creates each account in the admin room)
LEON_PASSWORD=
MIA_PASSWORD=
IRMA_PASSWORD=
KIRA_PASSWORD=
# v6.3: Устина, a second companion (the owner creates her account in the admin room)
USTYNA_PASSWORD=
GEMINI_API_KEY=
# v4.7: the Gemini agents' model (tunable in the panel)
GEMINI_MODEL=gemini-2.5-flash
HISTORY_N=40
# v4.1: the reply cap; a reply cut by it is trimmed to its last complete sentence
REPLY_MAX_TOKENS=200
# v4.1: agent messages per wave, counting the one being answered (v1.2's value + 1)
MAX_BOT_TURNS=3
# v4.1: how many agents answer an owner message that names no one
OWNER_REPLIERS=2
# v4.1: if nobody answered the owner after this many seconds, the best-ranked unchosen agent does
FALLBACK_S=30
# v4.2: the cat — how often he reacts unasked, how often a reaction is a purr (free), his word cap
CAT_REACT_P=0.3
CAT_PURR_P=0.8
CAT_MAX_WORDS=12
# v4.3: how often one of his spoken lines retells a past-life thesis
CAT_MEMORY_P=0.25
# v4.3: the cat starts a conversation after this much silence, at most so many a day, in these local hours
CAT_NUDGE_IDLE_S=1200
CAT_NUDGES_PER_DAY=6
CAT_NUDGE_HOURS=09-22
# v4.5: Claude the philosopher reads this many room messages (RAM only)
CLAUDE_HISTORY_N=150
# v4.5: Claude brings a Guardian news item every CLAUDE_NEWS_EVERY_S, once the room has been quiet for
# CLAUDE_NEWS_IDLE_S (never less than BOT_WINDOW_S), at most so many a day, in these local hours
CLAUDE_NEWS_EVERY_S=3600
CLAUDE_NEWS_IDLE_S=300
CLAUDE_NEWS_PER_DAY=24
CLAUDE_NEWS_HOURS=09-01
# v7.1: an agent on Claude that is not Claude himself (engine = "claude-sdk" in its TOML): its answers' model and
# every other call's, the CLI processes at once in its container, and at the subscription's limit Gemini until the
# reset (`gemini`, needs GEMINI_API_KEY) or silence (`silent`); per agent in the panel
CLAUDE_REPLY_MODEL=sonnet
CLAUDE_BACKGROUND_MODEL=haiku
CLAUDE_CONCURRENCY=2
CLAUDE_LIMIT_FALLBACK=gemini
# v7.1: the voice's calls think before they answer — `off`, or `adaptive` at CLAUDE_EFFORT (low | medium | high | max);
# the background calls never think
CLAUDE_THINKING=off
CLAUDE_EFFORT=low
# 7.3.1: the voice's answer from a CLI started ahead, its canon and life as the system prompt (`on`), or the whole
# instruction as the system prompt with no CLI ahead (`off`)
CLAUDE_WARM=on
# v5.1: Hermes's digests of the room — every HERMES_DIGEST_EVERY_S, after at least so many new messages, at most so
# many characters (~1,000 a minute of speech), in these local hours; at most so many spoken characters a month (0:
# text only); his ElevenLabs voice id (empty: text only). His password and the ElevenLabs key live in
# server/hermes.env (dev mode: HERMES_PASSWORD and ELEVENLABS_API_KEY in this file)
HERMES_DIGEST_EVERY_S=14400
HERMES_DIGEST_MIN_MESSAGES=5
HERMES_DIGEST_MAX_CHARS=1500
HERMES_DIGEST_HOURS=09-23
HERMES_TTS_MONTHLY_CHARS=150000
HERMES_VOICE_ID=
# v5.3: the speakers' voices — each agent's own ElevenLabs voice id (its <NAME>_VOICE_ID; empty: text), how often a
# line other than an answer to the owner's voice goes out in voice, and one monthly budget for all of them
ADA_VOICE_ID=
BRUNO_VOICE_ID=
KIT_VOICE_ID=
CLAUDE_VOICE_ID=
LEON_VOICE_ID=
MIA_VOICE_ID=
IRMA_VOICE_ID=
KIRA_VOICE_ID=
USTYNA_VOICE_ID=
# v5.4: the owner's cloned ElevenLabs voice — Hermes's recording speaks his typed lines in it (empty: left out)
OWNER_VOICE_ID=
VOICE_REPLY_P=1.0
VOICE_MONTHLY_CHARS=200000
BOT_REPLY_P=0.5
# v4.6: Ada's and Bruno's move per reply — ask someone by name, disagree, mention a plan, tell a life story; the
# rest is a plain answer (the most common move)
PERSONA_ASK_P=0.25
PERSONA_DISAGREE_P=0.15
PERSONA_PLAN_P=0.1
PERSONA_STORY_P=0.1
# v5.12: a person with `thoughts` (Кіра) — bring up what she read or thought today; anyone else answers plainly
PERSONA_THOUGHT_P=0.1
REPLY_DELAY_S=4
BOT_WINDOW_S=600
SESSION_IDLE_S=900
SESSION_MAX_MESSAGES=200
SUMMARY_MAX_WORDS=200
LOCATION=Львів, Україна
TIMEZONE=Europe/Kyiv
PLAN_MAX_WORDS=120
PLAN_MUTATION_RATE=0.3
MEMORY_DAYS=7
MEMORY_WEEKS=4
MEMORY_MONTHS=6
DAY_MEMORY_MAX_WORDS=120
WEEK_MEMORY_MAX_WORDS=150
MONTH_MEMORY_MAX_WORDS=200
YEAR_MEMORY_MAX_WORDS=300
TODAY_MAX_WORDS=100
# v3.1 token report — USD per 1M tokens; leave empty for no cost column
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=
# v5.1 — a model's own price pair, comma-separated model=in/out (USD per 1M tokens); others use the pair above
PRICE_MODELS=gemini-3.1-pro-preview=2/12,claude-opus-5-5=4/20
# v5.18 — a model's price per second of video, comma-separated model=usd (her кружечки on fal)
PRICE_SECONDS=veed/fabric-1.0=0.08,fal-ai/kling-video/ai-avatar/v2/standard=0.0562,fal-ai/kling-video/ai-avatar/v2/pro=0.115
# v6.5 — a model's price per image, comma-separated model=usd (her photos on fal, Seedream 4)
PRICE_IMAGES=fal-ai/bytedance/seedream/v4/edit=0.03,fal-ai/bytedance/seedream/v4/text-to-image=0.03
# v5.19 — a service's monthly fee, comma-separated service=usd (the usage line's engine: elevenlabs,
# deepgram, novelai, claude-sdk); the Analytics view prorates it over a period, for all agents only
PRICE_SUBSCRIPTIONS=
