# Nothing secret or lived ever enters the image (v3.2): env and state/ come only from the host.
.env
.env.*
!.env.example
server/.env
server/claude.env
# any copy of a server env file (a backup, an editor's swap) — never the examples (v4.4 review #15)
server/*.env*
!server/*.env.example
server_con.yaml
state/
reports/
# not needed in the image
.git/
.github/
.venv/
.claude/
tools/
specification/
tests/
scripts/
**/__pycache__/
**/*.pyc
.ruff_cache/
.pytest_cache/
.DS_Store
*.vsix
